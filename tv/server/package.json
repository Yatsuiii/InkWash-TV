    "cli": "node dev.mjs --cli"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.34.2",
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1147.0",
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/client-polly": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0"
  },
  "engines": {
    "node": ">=20"
  }
